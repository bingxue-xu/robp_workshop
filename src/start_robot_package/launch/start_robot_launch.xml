<?xml version="1.0"?>
<launch>
	<!-- launch the front_camera -->
	<include file="$(find-pkg-share start_robot_package)/launch/front_camera_launch.py" />


	<!-- launch the phidgets -->
	<include file="$(find-pkg-share start_robot_package)/launch/phidgets_launch.py" />


	<!-- launch the lidar -->
	<include file="$(find-pkg-share rplidar_ros)/launch/rplidar.launch.py" />
	
	<!-- launch the nodes -->
	<include file="$(find-pkg-share start_robot_package)/launch/start_nodes_launch.xml" />

	<!-- run the usb_cam -->
	<node pkg="usb_cam" exec="usb_cam_node_exe" name="usb_cam" args = " --ros-args --params-file $(find-pkg-share start_robot_package)/yaml/config.yaml">
	</node>
	
	<!-- run static trasnsform odom-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0 0 0 0 0 0 map odom">
	</node>
	
	<!-- run static trasnsform camer_link-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = " 0.08987 0.0175 0.10456 0 0 0 base_link camera_link">
	</node>
	
	<!-- run static trasnsform LAser-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0.0100 0.0950 0.14456 0 0 0 base_link laser">
	</node>
	
	<!-- run static trasnsform IMU-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0.00107 0 0.02361 0 0 0 base_link imu_link">
	</node>
	
	<!-- run static trasnsform Robot_arm_base-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0 -0.047 0.11456 0 0 0 base_link Robot_arm_base">
	</node>

	<!-- run rviz -->
	<node pkg="rviz2" exec="rviz2" name="rviz" args="-d $(find-pkg-share start_robot_package)/rviz/start.rviz" />
	
	<!-- run arcuo_node -->
	<node name="aruco" pkg="aruco_ros" exec="marker_publisher" output='screen'>
		<remap from="/camera_info" to="/camera/color/camera_info"/>
		<remap from="/image" to="/camera/color/image_raw"/>
		
		<param name="image_is_rectified" value="True"/>
		<param name="marker_size"        value="0.05"/> <!-- in m -->
		<param name="reference_frame"    value=""/>   <!-- frame in which the marker pose will be refered -->
		<param name="camera_frame"       value="camera_color_optical_frame"/>
	</node>

	<!-- run the micro_ros_controller -->
	<node pkg="micro_ros_agent" exec="micro_ros_agent" name="micro_ros_agent" args = " serial --dev /dev/arm -v6">
	</node>




</launch>
