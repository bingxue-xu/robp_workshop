<?xml version="1.0"?>
<launch>
	<!-- launch the nodes -->
	<include file="$(find-pkg-share start_robot_package)/launch/start_nodes_launch.xml" />
	
	<!-- run static trasnsform odom-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0 0 0 0 0 0 map odom">
	</node>
	
	<!-- run static trasnsform camer_link-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = " 0.08987 0.0175 0.10456 0 0 0 base_link camera_link">
	</node>
	
	<!-- run static trasnsform LAser-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0.0100 0.0950 0.14456 0 0 0 base_link laser">
	</node>
	
	<!-- run static trasnsform IMU-->
	<node pkg="tf2_ros" exec="static_transform_publisher" name="static_transform_publisher" args = "0.00107 0 0.02361 0 0 0 base_link imu_link">
	</node>

	<!-- run rviz -->
	<node pkg="rviz2" exec="rviz2" name="rviz" args="-d $(find-pkg-share start_robot_package)/rviz/start.rviz" />



</launch>
