<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="bt_groot2.xml"/>
    <include path="tutorial_01_simple_tree.xml"/>
    <include path="tutorial_02_ports.xml"/>
    <include path="tutorial_03_ports_with_types.xml"/>
    <include path="tutorial_04_reactive.xml"/>
    <include path="tutorial_05_subtrees.xml"/>
    <include path="tutorial_06_remapping.xml"/>
    <include path="tutorial_07_prepost.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="ApproachObject" editable="true"/>
        <Action ID="Backup15cm" editable="true"/>
        <Action ID="CalculateGoal" editable="true">
            <output_port name="goal"/>
        </Action>
        <Condition ID="CheckBattery" editable="true"/>
        <Action ID="CheckClaws" editable="true"/>
        <Action ID="CheckDist" editable="true"/>
        <Action ID="CheckExplored" editable="true"/>
        <Action ID="CheckWaypoints" editable="true"/>
        <Action ID="CloseGripper" editable="true"/>
        <Decorator ID="EnterGuard" editable="true"/>
        <Action ID="ExplorePathCal" editable="true"/>
        <Action ID="GetObjList" editable="true"/>
        <Action ID="GetRobPose" editable="true"/>
        <Action ID="GetTarrList" editable="true"/>
        <Action ID="GlobalPlanning" editable="true"/>
        <Action ID="Initialize" editable="true"/>
        <Condition ID="IsDoorClosed" editable="true"/>
        <Action ID="LocalPlanning" editable="true"/>
        <Action ID="MoveArmFalse" editable="true"/>
        <Action ID="MoveBase" editable="true">
            <input_port name="goal"/>
        </Action>
        <Action ID="ObjInHand" editable="true"/>
        <Action ID="OpenDoor" editable="true"/>
        <Action ID="OpenGripper" editable="true"/>
        <Action ID="PassThroughDoor" editable="true"/>
        <Action ID="PickLock" editable="true"/>
        <Action ID="Pickup" editable="true"/>
        <Action ID="Place" editable="true"/>
        <Action ID="PrintTarget" editable="true">
            <input_port name="target"/>
        </Action>
        <Action ID="PublishMapDone" editable="true"/>
        <Action ID="PurePuresuit" editable="true"/>
        <Action ID="RemoeGlobalObs" editable="true"/>
        <Action ID="RemoveTargetFromList" editable="true"/>
        <Action ID="SaySomething" editable="true">
            <input_port name="message"/>
        </Action>
        <Action ID="SetCurrTarget" editable="true">
            <input_port name="message"/>
        </Action>
        <Action ID="SliceGlobalWaypoints" editable="true"/>
        <Action ID="SmashDoor" editable="true"/>
        <Action ID="ThinkWhatToSay" editable="true">
            <output_port name="text"/>
        </Action>
        <Action ID="UpdateObsMap" editable="true"/>
        <Action ID="UsbCam" editable="true"/>
        <Action ID="VizGrid" editable="true"/>
        <Condition ID="goalReached" editable="true"/>
        <Action ID="retrace_step" editable="true">
            <output_port name="goal"/>
        </Action>
        <Action ID="tutorial01" editable="true"/>
    </TreeNodesModel>
</root>
