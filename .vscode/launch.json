    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "USBCam",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hardware_test/hardware_test/usb_cam_check.py",
            "args": [
                "--ros-args",
                "-p", "robot_name:=sneezy",
                "-p", "domain_id:=0",
                "-p", "json_folder:=/home/bingxue/dd2419/workshop_ws/src/hardware_test/test_results",
                "-p", "topic_name:=/camera1/image_raw",
                "-p", "timeout_s:=100.0",
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}