{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "check",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hardware_test/hardware_test/usb_cam_check.py",
            "args": [
                "--ros-args",
                "-p",
                "robot_name:=Sleepy",
                "-p",
                "domain_id:=7"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "C/C++: Debug icp_odometry",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/../install/icp_odometry/lib/icp_odometry/icp_odometry",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/..",
            "environment": [
                {"name":"ROS_DOMAIN_ID", "value":"0"},
                {"name":"AMENT_PREFIX_PATH", "value": "${workspaceFolder}/install"},
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "build icp_odometry",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug odometry_test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hardware_test/hardware_test/odometry_test.py",
            "args": [
                "--ros-args",
                "-p",
                "robot_name:=Sleepy",
                "-p",
                "domain_id:=0",
                "-p",
                "direction:=ccw",
                "-p",
                "lap:=10",
                "-p",
                "square_size:=3.0",
                "-p",
                "angular_speed:=1.2",
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "ROS_DOMAIN_ID": "0"
            }
        },
        {
            "name": "Debug umbmark_analysis",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hardware_test/hardware_test/utils/umbmark_analysis.py",
            "args": [
                "hardware_test/test_results/odometry_test/Grumpy_umbmark.json",
                "--save-dir", 
                "hardware_test/test_results/odometry_test/",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "stopOnEntry": false,
            "justMyCode": false
        }
    ]
}
